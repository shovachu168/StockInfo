<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: also trust user-installed CAs so HTTPS traffic can be inspected with a proxy such as Charles. Release builds are not affected. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
