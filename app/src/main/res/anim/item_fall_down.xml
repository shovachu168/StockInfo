<?xml version="1.0" encoding="utf-8"?>
<!-- Card enter animation: slides down a little while fading in -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/material_motion_duration_medium_1"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate
        android:fromYDelta="-8%"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
